# ---------------------------------------------------------------------------
# Copy to `.env` at the repository root. Every workspace package reads from it.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (PgBouncer, port 6543) used by the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by `prisma migrate` — migrations cannot run
# through a transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth -------------------------------------------------------------------
# Signing key for the session JWT. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# How long a session stays valid.
JWT_EXPIRES_IN="7d"

# --- Blob storage (Supabase Storage) ---------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
# Service-role key. Server-side only — it bypasses row level security, so it
# must never be exposed to the browser. The browser only ever receives
# short-lived signed URLs minted by the API.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Private bucket that holds the uploaded documents.
SUPABASE_STORAGE_BUCKET="data-room-files"

# --- API --------------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed to call the API directly (browser dev server).
# In production the web app proxies through its own origin, so CORS is unused.
WEB_ORIGIN="http://localhost:3000"
# Max upload size accepted per file, in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# --- Web --------------------------------------------------------------------
# Origin of the deployed NestJS API. The Next.js app rewrites /api/* to it so
# the session cookie stays first-party. Server-side variable, not NEXT_PUBLIC_.
API_ORIGIN="http://localhost:4000"
